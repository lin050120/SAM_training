+    def _on_nonfinite_grads_diag(self, batch, step, nonfinite_params):
+        """Overridable hook fired when GRAD-GUARD skips a non-finite-gradient
+        step. Subclasses may snapshot the failing (augmented) batch, targets,
+        source ids and RNG state for offline root-cause analysis. No-op by
+        default; must never raise (the caller guards it anyway)."""
