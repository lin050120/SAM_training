+
+    def _handle_nonfinite_grads(self, phase, batch=None):
+        """Record a skipped (non-finite gradient) optimizer step, log a locating
+        hint + the FULL set of non-finite params, snapshot the failing batch via
+        the diagnostic hook, and fail closed if instability is sustained.
+
+        Grads are still un-clipped here (clipping would spread NaN across every
+        param), so we record every non-finite gradient tensor. The FIRST one in
+        named_parameters() order is only a locating HINT, NOT a proven root-cause
+        layer: backprop itself can propagate NaN downstream, so the true origin
+        may sit earlier in the graph than the first param scanned."""
+        self._grad_skip_total += 1
+        self._grad_skip_consecutive += 1
+        self._grad_skip_window.append(1)
+
+        # Record ALL non-finite gradient tensors, not just the first (Codex
+        # review): the first is only a hint. This full scan runs only on the
+        # rare bad step.
+        nonfinite_params = []
+        for name, p in self.model.named_parameters():
+            if p.grad is not None and not torch.isfinite(p.grad).all():
+                n_nan = int(torch.isnan(p.grad).sum())
+                n_inf = int(torch.isinf(p.grad).sum())
+                nonfinite_params.append({"name": name, "nan": n_nan, "inf": n_inf})
+        first_nonfinite = (
+            f"{nonfinite_params[0]['name']}"
+            f"(nan={nonfinite_params[0]['nan']},inf={nonfinite_params[0]['inf']})"
+            if nonfinite_params
+            else None
+        )
+
+        window = self._grad_skip_window
+        ratio = (sum(window) / len(window)) if window else 0.0
+        step = self.steps[phase]
+        logging.warning(
+            f"[GRAD-GUARD] non-finite gradients at train step {step}: skipping "
+            f"optimizer step. nonfinite_param_tensors={len(nonfinite_params)} "
+            f"first_nonfinite_param={first_nonfinite} (hint, not proven origin) "
+            f"consecutive={self._grad_skip_consecutive} "
+            f"total={self._grad_skip_total} "
+            f"window_ratio={ratio:.3f} ({sum(window)}/{len(window)})"
+        )
+        self.logger.log("GradGuard/skips_total", self._grad_skip_total, step)
+        self.logger.log("GradGuard/consecutive", self._grad_skip_consecutive, step)
+        self.logger.log("GradGuard/window_skip_ratio", ratio, step)
+        self.logger.log(
+            "GradGuard/nonfinite_param_tensors", len(nonfinite_params), step
+        )
+
+        # Snapshot the failing batch for offline culprit-finding (fully guarded:
+        # diagnostics must never take training down).
+        try:
+            self._on_nonfinite_grads_diag(batch, step, nonfinite_params)
+        except Exception as exc:
+            logging.warning(f"[GRAD-GUARD] diagnostic hook failed: {exc!r}")
+
+        stop_reason = None
+        if self._grad_skip_consecutive >= GRAD_GUARD_MAX_CONSECUTIVE_SKIPS:
+            stop_reason = (
+                f"{self._grad_skip_consecutive} consecutive non-finite gradient "
+                f"steps (limit {GRAD_GUARD_MAX_CONSECUTIVE_SKIPS})"
+            )
+        elif (
+            len(window) >= GRAD_GUARD_WINDOW_MIN_SAMPLES
+            and ratio > GRAD_GUARD_WINDOW_MAX_SKIP_RATIO
+        ):
+            stop_reason = (
+                f"non-finite gradient rate {ratio:.1%} over the last "
+                f"{len(window)} optimizer steps exceeds "
+                f"{GRAD_GUARD_WINDOW_MAX_SKIP_RATIO:.0%}"
+            )
+        if stop_reason is not None:
+            msg = (
+                f"[GRAD-GUARD] stopping training: {stop_reason}. "
+                f"last first_nonfinite_param={first_nonfinite} (hint), "
+                f"total_skips={self._grad_skip_total}"
+            )
+            logging.error(msg)
+            raise FloatingPointError(msg)
+
